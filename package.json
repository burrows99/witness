{
  "name": "@macquery-labs/witness",
  "version": "0.1.0",
  "description": "A CI gate that blocks a merge when changed code was never executed.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "check": "pnpm typecheck && pnpm typecheck:all && pnpm lint && pnpm knip && pnpm test:l0 && pnpm test:arch",
    "clean": "tsc --build --clean && rm -rf dist",
    "knip": "knip",
    "lint": "eslint .",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "lint:fix": "eslint . --fix",
    "witness": "node dist/cli/bin.js",
    "test": "vitest run",
    "test:arch": "vitest run --project arch",
    "test:l0": "vitest run --project l0",
    "test:l1": "vitest run --project l1",
    "test:l2": "vitest run --project l2",
    "test:l3": "vitest run --project l3",
    "test:l4": "vitest run --project l4",
    "typecheck": "tsc --build --force",
    "typecheck:all": "tsc --noEmit -p tsconfig.eslint.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.9.1",
    "knip": "^6.32.2",
    "playwright": "^1.62.1",
    "publint": "^0.3.24",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "bin": {
    "witness": "./dist/cli/bin.js",
    "witness-mcp": "./dist/mcp/bin.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macquery-labs/witness.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.1"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
