{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/*/index.ts",
    "src/*/bin.ts",
    "test/**/*.test.ts",
    "test/helpers/**/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "test/**/*.ts",
    "*.ts",
    "*.js"
  ],
  "ignoreBinaries": [
    "ffmpeg",
    "ffprobe",
    "vhs"
  ]
}
