// A whole stack, described.
//
// Not one service: a thing people use, the database it writes to, the mail it sends, and something
// watching all of it. Each is here because describing it needs a different half of the vocabulary —
// a UI with routes and locators, a REST API, real rows to query, a second UI on a second service.
//
//   docker compose up -d
//   ./bin/witness stack status
//   ./bin/witness action run tour      # the whole stack, walked once, narrated, recorded
{
  // What the COMMAND LINE is called — not what it drives. This said `stack`, so `witness help` opened
  // `stack — drive the local stack` while the binary is `witness`, and the name collided with the
  // `stack` noun listed three lines below it. The first thing anybody meeting the tool reads.
  "name": "witness",

  "services": {
    // The app. A git forge: a web UI, a REST API, and a database it actually writes to.
    "gitea": {
      "kind": "in-house",
      "port": 3020,
      "portVar": "GITEA_PORT",
      "container": "witness-gitea",
      "probe": { "path": "/user/login", "contains": "Sign In" },

      "secrets": {
        "user": { "literal": "witness-admin" },
        "email": { "literal": "witness-admin@example.com" },
        "credential": { "containerEnv": "WITNESS_ACCOUNT_CREDENTIAL" }
      },

      // Its REST API — the default one, so `witness api get /api/v1/version` talks to it.
      "api": {
        "auth": {
          "admin": {
            "provider": "basic",
            "username": { "secret": "user" },
            "from": { "secret": "credential" }
          }
        },
        "operations": {
          "version": { "path": "/api/v1/version", "summary": "which Gitea this is" },
          "repo": { "path": "/api/v1/repos/{owner}/{repo}", "auth": "admin", "summary": "one repository, as the API sees it" },
          "repos": { "path": "/api/v1/users/{owner}/repos", "auth": "admin", "summary": "everything an account owns" }
        }
      },

      "app": {
        "routes": {
          "home": "/",
          "signUp": "/user/sign_up",
          "login": "/user/login",
          "newRepo": "/repo/create",
          "forgotPassword": "/user/forgot_password",
          "explore": "/explore/repos"
        },
        "locators": {
          "signInLink": { "role": "link", "name": "Sign In" },
          "repoHeading": { "role": "heading", "name": "witness-demo" }
        }
      },

      "actions": {
        "register": {
          "summary": "the first account, made the way a person makes one",
          "steps": [
            { "goto": { "route": "signUp" } },
            { "caption": { "text": "Registering the first account", "sub": "which Gitea makes an administrator" } },
            { "type": { "on": { "label": "Username", "exact": true }, "value": "{secret.user}" } },
            { "type": { "on": { "label": "Email Address", "exact": true }, "value": "{secret.email}" } },
            { "type": { "on": { "label": "Password", "exact": true }, "value": "{secret.credential}" } },
            { "type": { "on": { "label": "Confirm Password", "exact": true }, "value": "{secret.credential}" } },
            { "click": { "role": "button", "name": "Register Account" } },
            { "waitForUrl": { "route": "home", "timeout": 20000 } },
            { "expect": { "on": { "text": "Account was successfully created" }, "because": "registering the first user signs them straight in" } }
          ]
        },

        "askForAReset": {
          "summary": "the one thing a fresh install will actually send mail about",
          "steps": [
            { "caption": { "text": "Asking it to send something", "sub": "an account recovery email" } },
            { "goto": { "route": "forgotPassword" } },
            { "type": { "on": { "label": "Email Address", "exact": true }, "value": "{secret.email}" } },
            { "click": { "role": "button", "name": "Send Account Recovery Email" } },
            { "wait": 600 }
          ]
        },

        "explore": {
          "summary": "what an anonymous visitor sees",
          "steps": [
            { "goto": { "route": "explore" } },
            { "wait": 700 }
          ]
        },

        "exploreFromElsewhere": {
          "summary": "the browser half, driven from a directory that has no node_modules — the shape `--config` outside the repo exists for",
          "records": "terminal",
          "steps": [
            { "caption": { "text": "a directory with nothing installed in it, pointed at this stack" } },
            { "type": { "on": "prompt", "value": "W=$PWD; cd $(mktemp -d); pwd; ls -a" } },
            { "press": "Enter" },
            { "wait": 900 },
            { "type": { "on": "prompt", "value": "node $W/bin/cli.ts config explore gitea --pages=1 --config $W/.witness/config.jsonc | head -8" }, "note": "the checkout's own CLI, so this cut is about the code in the diff and not about whatever is installed globally" },
            { "press": "Enter" },
            { "wait": 25000, "note": "a page is waited on before it is read, and a browser has to start first" }
          ]
        },

        "createRepo": {
          "summary": "a repository, through the screen a person uses",
          "steps": [
            { "caption": { "text": "Creating a repository", "sub": "witness-demo" } },
            { "goto": { "route": "newRepo" } },
            { "type": { "on": { "label": "Repository Name" }, "value": "witness-demo" } },
            { "click": { "role": "button", "name": "Create Repository" } },
            { "waitForUrl": { "url": "witness-admin/witness-demo$", "timeout": 20000 } },
            { "expect": { "on": { "role": "heading", "name": "witness-demo" }, "because": "the repository page should show what was just made" } }
          ]
        }
      }
    },

    // All console, no document. The app `config explore` reads as empty even once it has waited —
    // which is the case the fragment now has to say something about, rather than report a walk of one
    // page and leave it looking like an app with one page.
    "keycloak": {
      "kind": "in-house",
      "port": 8092,
      "portVar": "KEYCLOAK_PORT",
      "container": "witness-keycloak",
      "probe": { "path": "/realms/master", "contains": "master" },
      "actions": {
        "describeItself": {
          "summary": "what `config explore` says about an app that offers nothing — the case that used to be silent",
          "records": "terminal",
          "steps": [
            { "caption": { "text": "asking witness what Keycloak says about itself" } },
            { "type": { "on": "prompt", "value": "./bin/witness config explore keycloak --pages=2 | head -12" } },
            { "press": "Enter" },
            { "wait": 20000, "note": "one page, but it is waited on before it is read" }
          ]
        }
      }
    },

    // What it writes to. The layer a screen can disagree with.
    "postgres": {
      "kind": "in-house",
      "port": 5441,
      "portVar": "POSTGRES_PORT",
      "container": "witness-postgres",
      "probe": "container",
      "database": {
        "user": "gitea",
        "database": "gitea",
        "credential": { "containerEnv": "POSTGRES_PASSWORD" },
        "queries": {
          "accounts": "select count(*) from \"user\"",
          "account.byName": "select name, email, is_admin from \"user\" where name = '{name}'",
          "repositories": "select count(*) from repository"
        }
      }
    },

    // The half with no screen. Every stack has one — a migration, a queue worker, the psql somebody
    // actually types — and Playwright is the wrong tool for filming it. `records` says what CAPTURES
    // it; the `video` block is the other end, and turns whatever was captured into one file.
    "shell": {
      "kind": "in-house",
      "port": 5441,
      "portVar": "POSTGRES_PORT",
      "container": "witness-postgres",
      "probe": "container",
      "records": "terminal",
      "shell": "docker exec -it witness-postgres bash",

      "actions": {
        "readTheDatabase": {
          "summary": "the database, from a prompt, the way a person actually looks",
          "steps": [
            { "caption": { "text": "what the app wrote, from a shell" } },
            { "type": { "on": "prompt", "value": "psql -U gitea -d gitea -c 'select name, email, is_admin from \"user\"'" } },
            { "press": "Enter" },
            { "wait": 1800 },
            { "type": { "on": "prompt", "value": "psql -U gitea -d gitea -c 'select owner_name, name, is_private from repository'" } },
            { "press": "Enter" },
            { "wait": 1800 }
          ]
        }
      }
    },

    // What it sends. A second UI and a second API, which is the point of it being here.
    "mailpit": {
      "kind": "in-house",
      "port": 8025,
      "portVar": "MAILPIT_PORT",
      "container": "witness-mailpit",
      "probe": { "path": "/api/v1/messages", "contains": "messages" },
      "api": { "operations": { "messages": { "path": "/api/v1/messages", "summary": "everything the stack has sent" } } },
      "app": {
        "routes": { "inbox": "/" },
        "locators": { "empty": { "text": "No results" } }
      },
      "actions": {
        "openInbox": {
          "summary": "what the stack has actually sent, on the screen a person reads it on",
          "steps": [
            { "caption": { "text": "The mail it sent", "sub": "caught before it left the machine" } },
            { "goto": { "route": "inbox" } },
            { "wait": 800, "note": "the inbox is a client-side app; the list arrives after the document" }
          ]
        }
      }
    },

    // What watches it. Somebody else's software, described the same way as our own.
    "grafana": {
      "kind": "in-house",
      "port": 3010,
      "portVar": "GRAFANA_PORT",
      "container": "witness-grafana",
      "probe": { "path": "/api/health", "contains": "database" },
      "secrets": {
        "adminUser": { "containerEnv": "GF_SECURITY_ADMIN_USER" },
        "adminPassword": { "containerEnv": "GF_SECURITY_ADMIN_PASSWORD" }
      },
      "api": {
        "auth": {
          "admin": {
            "provider": "basic",
            "username": { "secret": "adminUser" },
            "from": { "secret": "adminPassword" }
          }
        },
        "operations": { "health": { "path": "/api/health", "summary": "up, and is its database reachable" } }
      },
      "app": {
        "routes": { "login": "/login", "home": "/", "dataSources": "/connections/datasources" },
        "locators": { "welcome": { "text": "Welcome to Grafana" } }
      },
      "actions": {
        "signIn": {
          "summary": "sign in, and get past the password prompt",
          "steps": [
            { "goto": { "route": "login" } },
            { "type": { "on": { "placeholder": "email or username" }, "value": "{secret.adminUser}" } },
            { "type": { "on": { "placeholder": "password" }, "value": "{secret.adminPassword}" }, "note": "the declared secret, read out of the running container" },
            { "click": { "role": "button", "name": "Log in" } },
            { "click": { "role": "button", "name": "Skip", "exact": true }, "note": "Grafana renders Skip as a button styled as a link — the frame said so" },
            { "waitForUrl": { "route": "home", "timeout": 15000 } },
            { "expect": { "on": { "text": "Welcome to Grafana" }, "because": "the home page greets a signed-in admin" } }
          ]
        },
        "describeItself": {
          "summary": "what `config explore` reads off a client-rendered app — no browser, just the CLI",
          "records": "terminal",
          // A whole fragment is about seventy rows, and the default pane holds thirty — so this used
          // to be piped through `head -30`, which truncated the thing being demonstrated to fit the
          // thing filming it. The pane is the part that was wrong.
          "pane": { "height": 1350, "fontSize": 14 },
          "steps": [
            { "caption": { "text": "asking witness what Grafana says about itself" } },
            { "type": { "on": "prompt", "value": "./bin/witness config explore grafana --pages=6" } },
            { "press": "Enter" },
            { "wait": 30000, "note": "the crawl waits for each page to settle, so this has to outlast six of them" }
          ]
        },

        "openDataSources": {
          "summary": "what it can query — nothing yet, which is what a fresh install looks like",
          "steps": [
            { "caption": { "text": "What is watching", "sub": "Grafana, with nothing connected yet." } },
            { "goto": { "route": "dataSources" } },
            { "wait": 600 }
          ]
        }
      }
    }
  },

  // About more than one service, so they live here rather than under any of them.
  "actions": {
    // The one output this tool cannot point a browser at: its own instructions. What an agent given
    // the skill and nothing else can reach for is exactly this list — a command missing from it does
    // not exist, whatever the command line can actually do.
    "theCommandsItAdvertises": {
      "summary": "the noun list the generated skill hands an agent",
      "records": "terminal",
      "steps": [
        { "caption": { "text": "what witness skill says this copy can do" } },
        {
          "type": { "on": "prompt", "value": "./bin/witness skill | sed -n '/^## Commands/,/^## This project/p' | grep '^- '" }
        },
        { "press": "Enter" },
        { "wait": 8000, "note": "it loads the description first, and the list arrives in one write — so it is waited on before it is read" }
      ]
    },

    // The other half of what an agent reads before it has run anything: where a run puts what it
    // produced, and what it takes to get one of those files in front of a person. Both are claims
    // the skill makes about the world outside this tool, and nothing type-checks either.
    "theEvidenceItDescribes": {
      "summary": "what the generated skill says a run leaves behind, and how to attach it",
      "records": "terminal",
      "pane": { "height": 1100, "fontSize": 16 },
      "steps": [
        { "caption": { "text": "what witness skill says a run leaves behind" } },
        {
          "type": { "on": "prompt", "value": "clear; ./bin/witness skill | sed -n '/^## What a run leaves behind/,/^## The description/p' | sed '$d'" }
        },
        { "press": "Enter" },
        { "wait": 8000, "note": "the description loads first and the section arrives in one write; the last `sed` drops the heading the range ran on to" }
      ]
    },

    // The one action about the DESCRIPTION rather than the product: generate one off this repo's own
    // compose file and read the board off it. Every row on that board is a claim about a container
    // `docker ps` can be asked about, which is why both end up on the same final screen — a board
    // nobody can compare against the machine is a board nobody can disbelieve.
    "theGeneratedDescription": {
      "summary": "a description read off the compose file, and the status board it produces",
      "records": "terminal",
      "steps": [
        { "caption": { "text": "generating a description from this repo's own compose file" } },
        { "type": { "on": "prompt", "value": "rm -rf /tmp/witness-board && mkdir -p /tmp/witness-board/witness && cp docker-compose.yml .env /tmp/witness-board/witness/ && (cd /tmp/witness-board/witness && git init -q .)" }, "note": "a directory named for the compose project, because that is what names the containers" },
        { "press": "Enter" },
        { "wait": 2000 },
        { "type": { "on": "prompt", "value": "./bin/witness init /tmp/witness-board/witness | tail -4" } },
        { "press": "Enter" },
        { "wait": 9000, "note": "`docker compose config` shells out, and it is not quick on a machine running four stacks" },
        { "type": { "on": "prompt", "value": "clear; echo 'docker ps:'; docker ps | awk 'NR>1 {print $NF}' | grep ^witness | sort; echo" }, "note": "neither `--format '{{.Names}}'` nor a backslash: a step's text is interpolated, so a brace pair reads as a missing parameter, and VHS drops a backslash out of a `Type` string" },
        { "press": "Enter" },
        { "wait": 2500, "note": "the ground truth every row below is a claim about" },
        { "type": { "on": "prompt", "value": "./bin/witness --config /tmp/witness-board/witness/.witness/config.jsonc stack status --quiet" } },
        { "press": "Enter" },
        { "wait": 25000, "note": "an HTTP probe waits 4s before giving up, and three of these are pointed at things that never answer one" }
      ]
    },

    "theApp": {
      "summary": "the app a person uses",
      "steps": [
        {
          "slide": {
            "title": "Four services, at once",
            "kicker": "one description · one video",
            "lines": [
              "top left — the app: somebody registers and makes a repository",
              "top right — what a stranger sees of it, signed out",
              "bottom left — the mail it sends, caught before it leaves",
              "bottom right — what is watching all of it"
            ]
          }
        },
        { "run": "gitea.register" },
        { "run": "gitea.createRepo" },
        { "run": "gitea.askForAReset" },
        { "frame": "the repository, on screen" }
      ]
    },

    "theOutsider": {
      "summary": "the same app, from outside, signed in as nobody",
      "steps": [
        { "run": "gitea.explore" },
        { "wait": 5500, "note": "looking again is the point: the pane shows the repository ARRIVING, not a still of it" },
        { "run": "gitea.explore" },
        { "wait": 5500 },
        { "run": "gitea.explore" },
        { "frame": "what a stranger sees" }
      ]
    },

    "theWatcher": {
      "summary": "what is watching it",
      "steps": [
        { "run": "grafana.signIn" },
        { "run": "grafana.openDataSources" },
        { "frame": "nothing connected yet" }
      ]
    },

    "theMail": {
      "summary": "where its mail actually goes",
      "steps": [
        { "run": "mailpit.openInbox" },
        { "wait": 5500, "note": "empty at first, on purpose: nothing has been sent yet" },
        { "reload": true },
        { "wait": 5500 },
        { "reload": true },
        { "wait": 800 },
        { "frame": "the inbox, once the app had sent something" }
      ]
    },
    "tour": {
      "summary": "the whole stack, walked once: the app, the database it wrote to, the mail it sent, and what watches it",
      "steps": [
        {
          "slide": {
            "title": "One stack, one description",
            "lines": [
              "An app, the database it writes to, the mail it sends, and what watches it.",
              "Four services in one config file. No test file.",
              "Every claim below is checked against the layer it is about."
            ]
          }
        },

        { "slide": { "title": "1 · The app", "lines": ["Registering the first account, through the screen a person uses."] } },
        { "run": "gitea.register" },
        { "frame": "registered, and signed in" },

        { "slide": { "title": "2 · The database", "lines": ["The screen says there is an account.", "Postgres is the layer that can disagree."] } },
        { "query": { "name": "accounts", "as": "accounts" } },
        { "check": { "that": "{accounts}", "contains": "1", "because": "the account the screen just made should be a row" } },
        { "query": { "name": "account.byName", "params": { "name": "witness-admin" }, "as": "account" } },
        { "check": { "that": "{account}", "contains": "witness-admin@example.com", "because": "and it should be the account we registered, not some other one" } },

        { "slide": { "title": "3 · The app again", "lines": ["A repository, made on screen —", "then asked of Gitea's own API."] } },
        { "run": "gitea.createRepo" },
        { "frame": "the repository, on screen" },
        { "api": { "operation": "repo", "params": { "owner": "witness-admin", "repo": "witness-demo" }, "as": "repo" } },
        { "check": { "that": "{repo.full_name}", "equals": "witness-admin/witness-demo", "because": "the screen and the API should agree that it exists" } },
        { "query": { "name": "repositories", "as": "repositories" } },
        { "check": { "that": "{repositories}", "contains": "1", "because": "and so should the database underneath both" } },

        { "slide": { "title": "4 · The mail", "lines": ["The app sends a message.", "It never leaves the machine — this is where it lands."] } },
        { "run": "gitea.askForAReset" },
        { "run": "mailpit.openInbox" },
        { "frame": "the inbox" },
        { "api": { "client": "mailpit", "operation": "messages", "as": "mail" }, "note": "a second service answering — `client` says which" },
        { "check": { "that": "{mail.messages_count}", "atLeast": 1, "because": "registering an account sends a message, and this is where it lands" } },

        { "slide": { "title": "5 · What watches it", "lines": ["Somebody else's software, described the same way as our own."] } },
        { "run": "grafana.signIn" },
        { "run": "grafana.openDataSources" },
        { "frame": "nothing connected yet" },

        { "slide": { "title": "Four services, one run", "lines": ["Screen, database, API and mail — each checked against the others.", "It is all in .witness/config.jsonc."] } }
      ],
      "verify": {
        "title": "The whole stack, walked once",
        "subject": { "app": "http://localhost:3020", "mail": "http://localhost:8025", "watching": "http://localhost:3010", "account": "witness-admin" },
        "signIn": ["docker compose up -d", "open http://localhost:3020 — witness-admin"],
        "notes": [
          "Registered witness-admin through the web UI; Gitea made it an administrator.",
          "Postgres held {accounts} account and {repositories} repository afterwards.",
          "Gitea's own API agreed the repository exists: {repo.full_name}.",
          "The mail it sent was caught by Mailpit rather than delivered.",
          "Nothing here was seeded by hand: every row was made through the product."
        ]
      }
    }
  },

  // What the command line can answer without opening a browser.
  "cli": {
    "accounts": {
      "summary": "who exists, according to the database",
      "verbs": { "count": { "query": "accounts", "summary": "how many" }, "show": { "query": "account.byName", "args": ["name"], "summary": "<name> — one of them" } }
    },
    "mail": {
      "summary": "what the stack has sent",
      "verbs": { "list": { "client": "mailpit", "operation": "messages", "summary": "every message caught" } }
    }
  }
}
