{
  "name": "@macquery-labs/driver-web",
  "version": "0.1.0",
  "description": "Playwright driver: accessible-role actions, a11y snapshots, per-request trace spans.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@macquery-labs/core": "workspace:*",
    "@macquery-labs/driver-api": "workspace:*",
    "@macquery-labs/recorders": "workspace:*"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "playwright": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/macquery-labs/witness.git",
    "directory": "packages/driver-web"
  }
}
