{
  "name": "@witness/cli",
  "version": "0.1.0",
  "description": "The witness binary \u2014 the only package that composes everything.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "witness": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@witness/core": "workspace:*",
    "@witness/driver-api": "workspace:*",
    "@witness/driver-web": "workspace:*",
    "@witness/probe-dap": "workspace:*",
    "@witness/recorders": "workspace:*",
    "@witness/vcs": "workspace:*",
    "@witness/viewer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
