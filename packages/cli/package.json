{
  "name": "@macquery-labs/cli",
  "version": "0.1.0",
  "description": "The witness binary — the only package that composes everything.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "witness": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@macquery-labs/core": "workspace:*",
    "@macquery-labs/driver-api": "workspace:*",
    "@macquery-labs/driver-web": "workspace:*",
    "@macquery-labs/probe-dap": "workspace:*",
    "@macquery-labs/recorders": "workspace:*",
    "@macquery-labs/vcs": "workspace:*",
    "@macquery-labs/viewer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/macquery-labs/witness.git",
    "directory": "packages/cli"
  }
}
